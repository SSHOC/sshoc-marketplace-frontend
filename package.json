{
	"name": "@sshoc/sshoc-marketplace-frontend",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"analyze": "BUNDLE_ANALYZER=\"enabled\" next build --webpack",
		"build": "run-s generate:static-data build:app",
		"build:app": "run-s build:next types:check",
		"build:next": "next build",
		"dev": "next dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:static-data": "dotenv -c -- tsx ./scripts/generate-static-data.ts",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint --type-aware --type-check",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || lefthook install",
		"start": "next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"types:check": "tsc --noEmit"
	},
