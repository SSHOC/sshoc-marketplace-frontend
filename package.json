	"browserslist": {
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "./configs/stylelint.json",
		"rules": {
			"at-rule-empty-line-before": null,
			"block-no-empty": null,
			"declaration-block-no-duplicate-properties": null,
			"media-feature-range-notation": null
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26.x"
	},
	"packageManager": "pnpm@12.23.0",
	"postcss": {
		"plugins": {
			"postcss-nesting": {},
			"autoprefixer": {},
			"@tailwindcss/postcss": {}
		}
	}
