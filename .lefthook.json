{
	"$schema": "./node_modules/lefthook/schema.json",
	"pre-commit": {
		"commands": {
			"oxlint": {
				"run": "pnpm exec oxlint --fix --type-aware --type-check --no-error-on-unmatched-pattern {staged_files}",
				"stage_fixed": true
			},
			"stylelint": {
				"glob": "*.css",
				"run": "pnpm exec stylelint --fix {staged_files}",
				"stage_fixed": true
			},
			"oxfmt": {
				"run": "pnpm exec oxfmt --write --no-error-on-unmatched-pattern {staged_files}",
				"stage_fixed": true
			}
		}
	}
}
